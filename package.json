{
  "name": "cytest-automation",
  "version": "1.0.0",
  "type": "module",
  "description": "CompassionCare Cypress Test Automation Suite",
  "main": "cypress.config.js",
  "scripts": {
    "test": "cypress run",
    "test:ui": "cypress open",
    "test:cli": "cypress run --project ./cytest-automation",
    "test:cli:chrome": "cypress run --project ./cytest-automation --browser chrome",
    "test:cli:spec": "cypress run --project ./cytest-automation --spec 'cypress/e2e/pages/login.cy.js'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "devDependencies": {
    "cypress": "^13.0.0"
  }
}
